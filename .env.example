# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Tính năng AI phân tích (route /api/interpret) ───
# Khóa chỉ dùng ở phía máy chủ, không thêm tiền tố NEXT_PUBLIC_.
# Đặt giá trị thật trong .env.local (tệp này không được commit), rồi khởi động lại máy chủ.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Tùy chọn: đổi mô hình, mặc định claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Tài khoản: đăng nhập bằng Google ───
# Tạo OAuth client ID loại Web application ở Google Cloud Console.
# Địa chỉ chuyển hướng cần khai báo: <địa chỉ gốc của trang>/api/auth/google/callback
# Ví dụ khi chạy cục bộ ở cổng 8081: http://localhost:8081/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tùy chọn: địa chỉ gốc dùng làm đường chuyển hướng khi chạy sau máy chủ trung gian
# AUTH_ORIGIN=https://ten-mien-cua-ban
# Tùy chọn: đường dẫn tệp cơ sở dữ liệu SQLite, mặc định data/ung-dung.sqlite
# DATABASE_FILE=
